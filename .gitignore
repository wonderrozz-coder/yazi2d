# Build artifacts — never commit these. The repo often lives in a synced
# folder (Nextcloud/Dropbox), so keeping them out also avoids syncing GBs.
/target/
**/*.rs.bk

# Generated macOS app bundle (rebuilt by packaging/macos/build-app.sh)
/dist/

# Local runtime data
*.log
yazi2d.log*

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
vendor/ghostty/*
!vendor/ghostty/README.md
